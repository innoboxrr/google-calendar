{
    "name": "innoboxrr/google-calendar",
    "description": "Conecta la cuenta de Google de cada usuario con OAuth y opera los eventos de su calendario principal desde Laravel.",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Innoboxrr\\GoogleCalendar\\": "src/",
            "Innoboxrr\\GoogleCalendar\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Innoboxrr\\GoogleCalendar\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Homero Raul",
            "email": "h.raulvc@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "innoboxrr/larapack-generator": "^9.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Innoboxrr\\GoogleCalendar\\Providers\\AppServiceProvider",
                "Innoboxrr\\GoogleCalendar\\Providers\\AuthServiceProvider",
                "Innoboxrr\\GoogleCalendar\\Providers\\EventServiceProvider",
                "Innoboxrr\\GoogleCalendar\\Providers\\RouteServiceProvider"
            ]
        }
    }
}
